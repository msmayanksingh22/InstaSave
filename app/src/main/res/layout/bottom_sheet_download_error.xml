<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="38dp"
        android:layout_height="4.5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/card_background"
        android:backgroundTint="#3D4664" />

    <!-- Error Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/ivErrorIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_warning"
            app:tint="#EF4444"
            android:background="@drawable/card_background"
            android:backgroundTint="#3A171A"
            android:padding="10dp"
            android:contentDescription="Error Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvErrorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Could Not Resolve Media"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvErrorSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Please check your internet connection or verify that the post is public."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_stroke"
        android:layout_marginBottom="14dp" />

    <!-- Diagnostic Details Box -->
    <LinearLayout
        android:id="@+id/layoutDiagnosticBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:backgroundTint="#1F1418"
        android:padding="14dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Diagnostic Details"
            android:textColor="#F87171"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDiagnosticDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Error code: 404 Not Found"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Actions List -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp">

        <!-- Button 1: Retry (Primary Gradient) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnErrorRetry"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Retry Download"
            android:textColor="@color/white"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:background="@drawable/btn_hero_gradient"
            app:backgroundTint="@null"
            app:cornerRadius="14dp" />

        <!-- Button 2: Open in Instagram -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnErrorOpenInstagram"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Open in Instagram"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            app:strokeColor="@color/card_stroke"
            app:cornerRadius="14dp"
            android:layout_marginTop="8dp" />

        <!-- Button 3: Copy Debug Info -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnErrorCopyDebug"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Copy Debug Info"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp"
            app:strokeColor="@color/card_stroke"
            app:cornerRadius="14dp"
            android:layout_marginTop="8dp" />

        <!-- Button 4: Dismiss -->
        <Button
            android:id="@+id/btnErrorDismiss"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Dismiss"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />

    </LinearLayout>

</LinearLayout>
