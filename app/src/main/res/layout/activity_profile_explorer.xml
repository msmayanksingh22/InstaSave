<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootProfileExplorer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top Native Header & Inset Anchor -->
    <LinearLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_bg"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <!-- Back Button (Rounded Glassmorphic Pill) -->
            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/card_background"
                android:backgroundTint="@color/surface_elevated"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary"
                    android:contentDescription="Back" />
            </FrameLayout>

            <!-- Title & Subtitle Info (Tappable when creator handle detected) -->
            <LinearLayout
                android:id="@+id/layoutHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvProfileUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="\@anjaliandsnehal" />

                <TextView
                    android:id="@+id/tvProfileStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Profile Explorer • Tap post to save"
                    android:textColor="@color/primary"
                    android:textSize="11.5sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Refresh Button -->
            <FrameLayout
                android:id="@+id/btnRefresh"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/card_background"
                android:backgroundTint="@color/surface_elevated"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/text_primary"
                    android:contentDescription="Refresh" />
            </FrameLayout>

            <!-- Account & Local Session Safety Sheet Button -->
            <FrameLayout
                android:id="@+id/btnClearSession"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/card_background"
                android:backgroundTint="@color/surface_elevated"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivAccountSafetyIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_shield_check"
                    app:tint="@color/status_green"
                    android:contentDescription="Instagram Account &amp; Safety" />
            </FrameLayout>
        </LinearLayout>

        <!-- Native Progress Indicator -->
        <ProgressBar
            android:id="@+id/progressLoading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Main Content: SwipeRefreshLayout + Native Sandboxed WebView -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="61dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <WebView
            android:id="@+id/webViewProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_dark" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Offline / Error State -->
    <LinearLayout
        android:id="@+id/layoutErrorState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="28dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_cloud_download"
            app:tint="@color/text_muted"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Unable to load Instagram profile"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Check your internet connection and try again"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="18dp"
            android:text="Retry Loading"
            android:textAllCaps="false"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/btn_hero_gradient"
            app:backgroundTint="@null"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- Floating Native Action Pill (Pops up when user views/taps a post) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFloatingPostAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="@color/card_bg"
        app:strokeColor="@color/card_stroke_accent"
        app:strokeWidth="1.2dp"
        app:cardElevation="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Media Icon Badge -->
                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/card_background"
                    android:backgroundTint="@color/surface_elevated">

                    <ImageView
                        android:id="@+id/ivPillMediaIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_download_arrow"
                        app:tint="@color/primary"
                        android:contentDescription="Media detected" />
                </FrameLayout>

                <!-- Text Details -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPillTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Post Detected"
                        android:textColor="@color/text_primary"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvPillSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to save directly to Gallery"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Dismiss Button -->
                <FrameLayout
                    android:id="@+id/btnPillDismiss"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_close"
                        app:tint="@color/text_muted"
                        android:contentDescription="Dismiss" />
                </FrameLayout>
            </LinearLayout>

            <!-- Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- 1-Tap Save Post (Primary Gradient) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPillSavePost"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="⬇️ Save Post"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/btn_hero_gradient"
                    app:backgroundTint="@null"
                    app:cornerRadius="12dp" />

                <!-- Select Media (For carousels or preview) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPillSelectMedia"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Select"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1.2dp"
                    app:cornerRadius="12dp" />

                <!-- 1-Tap View Creator Profile -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPillViewProfile"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Profile"
                    app:icon="@drawable/ic_person"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="15dp"
                    app:iconTint="@color/text_primary"
                    android:textAllCaps="false"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    app:strokeColor="@color/card_stroke_glow"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
