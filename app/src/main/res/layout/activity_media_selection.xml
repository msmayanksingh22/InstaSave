<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootMediaSelection"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/selectionTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/card_bg">

        <ImageButton
            android:id="@+id/btnBackSelection"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/tvSelectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Media"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/tvSelectionSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to select items to download"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleSelectAll"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Clear All"
            android:textColor="@color/insta_pink"
            android:textSize="12sp"
            android:textStyle="bold"
            app:strokeColor="@color/insta_pink"
            app:strokeWidth="1dp"
            app:cornerRadius="18dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_stroke" />

    <!-- Media Tiles Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMediaTiles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"
        android:overScrollMode="never" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_stroke" />

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/selectionBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_bg"
        android:padding="16dp">

        <ProgressBar
            android:id="@+id/pbDownloadProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="false"
            android:indeterminateTint="@color/insta_pink"
            android:progressTint="@color/insta_pink"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDownloadStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownloadSelected"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:text="Download Selected (0)"
                android:textColor="@color/white"
                android:background="@drawable/btn_hero_gradient"
                app:backgroundTint="@null"
                app:cornerRadius="14dp"
                android:textStyle="bold"
                android:textSize="14.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopySelectedImage"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:textAllCaps="false"
                android:text="Copy"
                app:icon="@drawable/ic_copy_link"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                android:textColor="@color/white"
                app:strokeColor="@color/insta_pink"
                app:strokeWidth="1.2dp"
                app:iconTint="@color/insta_pink"
                android:backgroundTint="#261A35"
                app:cornerRadius="14dp"
                android:textStyle="bold"
                android:textSize="13.5sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
