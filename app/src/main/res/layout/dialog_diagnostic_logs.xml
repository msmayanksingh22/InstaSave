<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:backgroundTint="@color/card_bg"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_history"
            android:tint="@color/insta_pink"
            android:contentDescription="Diagnostics" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvLogsDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diagnostic Logs"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvLogsDialogSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="In-memory capture • Remote Diagnostics"
                android:textSize="11.5sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnLogsDialogClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:tint="@color/text_muted"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- Filter Buttons / Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvLogsCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 entries"
            android:textSize="11sp"
            android:textColor="@color/insta_coral"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFilterAll"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="All"
            android:textSize="10.5sp"
            android:textColor="@color/white"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <Button
            android:id="@+id/btnFilterErrors"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="Errors &amp; Warns"
            android:textSize="10.5sp"
            android:textColor="@color/text_secondary"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </LinearLayout>

    <!-- Scrollable Monospace Logs Area -->
    <ScrollView
        android:id="@+id/scrollLogs"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="@drawable/card_background"
        android:backgroundTint="@color/surface_inset"
        android:padding="10dp"
        android:fadeScrollbars="false">

        <TextView
            android:id="@+id/tvLogsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:typeface="monospace"
            android:textSize="10sp"
            android:textColor="#C0C8D8"
            android:textIsSelectable="true"
            android:lineSpacingExtra="2dp"
            android:text="Loading logs..." />
    </ScrollView>

    <!-- Action Buttons: Copy, Share, Clear -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp">

        <Button
            android:id="@+id/btnClearLogs"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Clear"
            android:textColor="@color/status_red"
            android:textSize="11.5sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnShareLogs"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Share"
            android:textColor="@color/text_primary"
            android:textSize="11.5sp" />

        <Button
            android:id="@+id/btnCopyLogs"
            style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Copy to Clipboard"
            android:textColor="@color/white"
            android:textSize="11.5sp"
            android:backgroundTint="@color/insta_pink"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
