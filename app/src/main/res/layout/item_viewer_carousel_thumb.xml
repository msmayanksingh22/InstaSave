<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardViewerThumb"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:layout_marginHorizontal="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#33FFFFFF"
    app:cardBackgroundColor="@color/card_bg">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivCarouselItemThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Thumbnail" />

        <TextView
            android:id="@+id/tvCarouselItemIndex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="2dp"
            android:background="#D9090A10"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:textStyle="bold"
            android:text="#1" />

        <ImageView
            android:id="@+id/ivCarouselVideoBadge"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="top|start"
            android:layout_margin="2dp"
            android:background="#D9090A10"
            android:padding="2dp"
            android:src="@drawable/ic_video"
            app:tint="@color/white"
            android:visibility="gone"
            android:contentDescription="Video" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
