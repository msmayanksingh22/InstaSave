<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_dark"
    android:focusableInTouchMode="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Top Header: Logo, Title, Live Service Pill Toggle -->
        <ImageView
            android:id="@+id/ivHomeLogo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_app_logo"
            android:contentDescription="@string/app_name"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvHomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginStart="10dp"
            app:layout_constraintTop_toTopOf="@id/ivHomeLogo"
            app:layout_constraintBottom_toBottomOf="@id/ivHomeLogo"
            app:layout_constraintStart_toEndOf="@id/ivHomeLogo" />

        <!-- Service Status Pill (Clickable & Accessible) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/pillServiceToggle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="17dp"
            app:cardBackgroundColor="#221C28"
            app:strokeColor="#3A2A44"
            app:strokeWidth="1dp"
            app:rippleColor="#33E1306C"
            app:layout_constraintTop_toTopOf="@id/ivHomeLogo"
            app:layout_constraintBottom_toBottomOf="@id/ivHomeLogo"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="12dp">

                <View
                    android:id="@+id/dotServicePill"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_indicator" />

                <TextView
                    android:id="@+id/tvServicePillText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Running"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- FrameLayout container around ViewStub keeps constraint anchor intact -->
        <FrameLayout
            android:id="@+id/permissionsAlertContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/ivHomeLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ViewStub
                android:id="@+id/stubPermissionsAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="@layout/banner_permissions_alert" />
        </FrameLayout>

        <!-- Hero Quick-Download Card (with goneMarginTop for clean spacing when banner is hidden) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuickDownload"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_goneMarginTop="14dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/card_bg"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/permissionsAlertContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QUICK DOWNLOAD"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/insta_pink"
                    android:letterSpacing="0.08" />

                <!-- Input with built-in end-icon Paste button -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilInstagramUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="#13131A"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="1dp"
                    app:boxStrokeColor="@color/insta_pink"
                    app:hintEnabled="false"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_copy_link"
                    app:endIconTint="@color/insta_pink"
                    app:endIconContentDescription="Paste Link">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etInstagramUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:hint="Paste Instagram link here..."
                        android:textColorHint="@color/text_muted"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:imeOptions="actionDone"
                        android:padding="12dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Gradient Download Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickDownload"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Download Media ⚡"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:cornerRadius="12dp"
                    android:background="@drawable/btn_rounded_accent"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recent Downloads Section Header -->
        <TextView
            android:id="@+id/tvRecentHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recent Downloads"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/cardQuickDownload"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/btnHomeSeeGallery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:text="See All ›"
            android:textColor="@color/insta_pink"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            app:layout_constraintTop_toTopOf="@id/tvRecentHeader"
            app:layout_constraintBottom_toBottomOf="@id/tvRecentHeader"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Horizontal Recent Downloads Shelf -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecentDownloads"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:overScrollMode="never"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/tvRecentHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Empty state placeholder -->
        <TextView
            android:id="@+id/tvNoRecent"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginTop="8dp"
            android:text="@string/no_recent_downloads"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:gravity="center"
            android:background="@drawable/card_background"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvRecentHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Barrier prevents chip overlap on empty state -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierRecentBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="rvRecentDownloads,tvNoRecent" />

        <!-- Compact Storage Footprint Chip (Anchored below Barrier) -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipStorageFootprint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Calculating storage..."
            android:textColor="@color/text_secondary"
            android:textSize="11.5sp"
            app:chipBackgroundColor="@color/card_bg"
            app:chipStrokeColor="@color/card_stroke"
            app:chipStrokeWidth="1dp"
            app:chipIcon="@drawable/ic_folder"
            app:chipIconTint="@color/insta_pink"
            app:layout_constraintTop_toBottomOf="@id/barrierRecentBottom"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
