<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_stroke"
    app:cardBackgroundColor="@color/card_bg"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- 72dp Thumbnail Container -->
        <FrameLayout
            android:id="@+id/flThumbnailContainer"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_history_thumb"
            android:clipToOutline="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/ivHistoryThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Thumbnail" />

            <!-- Type Icon Badge (Bottom-End) -->
            <ImageView
                android:id="@+id/ivHistoryTypeIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="3dp"
                android:background="#CC000000"
                android:padding="3dp"
                android:src="@drawable/ic_image"
                app:tint="@color/white"
                android:contentDescription="Type" />

            <!-- Deleted Badge (Top-Start) -->
            <ImageView
                android:id="@+id/ivDeletedBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|start"
                android:layout_margin="3dp"
                android:background="#CC000000"
                android:padding="3dp"
                android:src="@drawable/ic_cloud_download"
                app:tint="@color/insta_coral"
                android:visibility="gone"
                android:contentDescription="Deleted from local storage" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvHistoryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="\@creator"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="middle"
            app:layout_constraintTop_toTopOf="@id/flThumbnailContainer"
            app:layout_constraintStart_toEndOf="@id/flThumbnailContainer"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvHistorySubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Carousel • 12 photos • 20.1 MB"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/tvHistoryTitle"
            app:layout_constraintStart_toStartOf="@id/tvHistoryTitle"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Saved Date -->
        <TextView
            android:id="@+id/tvHistoryDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Saved on Nov 04, 2026 • shortcode"
            android:textColor="#888899"
            android:textSize="11sp"
            android:maxLines="1"
            app:layout_constraintTop_toBottomOf="@id/tvHistorySubtitle"
            app:layout_constraintStart_toStartOf="@id/tvHistoryTitle"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Status Pill Badge -->
        <LinearLayout
            android:id="@+id/layoutStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="#1B2B20"
            app:layout_constraintTop_toBottomOf="@id/tvHistoryDate"
            app:layout_constraintStart_toStartOf="@id/tvHistoryTitle">

            <View
                android:id="@+id/dotStatus"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_indicator" />

            <TextView
                android:id="@+id/tvStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="On Device • Ready"
                android:textColor="@color/status_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Barrier for top section -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierTopSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="flThumbnailContainer,layoutStatusBadge" />

        <!-- Progress ViewStub (Inflated only on queued or downloading rows) -->
        <ViewStub
            android:id="@+id/stubDownloadProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout="@layout/view_stub_download_progress"
            android:inflatedId="@+id/layoutDownloadProgress"
            app:layout_constraintTop_toBottomOf="@id/barrierTopSection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Bottom Action Row -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenInstagram"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minHeight="0dp"
            android:layout_marginTop="8dp"
            android:text="View Post ↗"
            android:textSize="12sp"
            android:textColor="@color/insta_pink"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            app:layout_constraintTop_toBottomOf="@id/stubDownloadProgress"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Re-download Progress Spinner -->
        <ProgressBar
            android:id="@+id/pbRedownload"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:indeterminateTint="@color/insta_pink"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/btnOpenInstagram"
            app:layout_constraintBottom_toBottomOf="@id/btnOpenInstagram"
            app:layout_constraintEnd_toStartOf="@id/btnViewMedia" />

        <!-- View Media Button (Shown if available on device) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewMedia"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minHeight="0dp"
            android:text="View Media"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/card_stroke"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:visibility="visible"
            app:layout_constraintTop_toTopOf="@id/btnOpenInstagram"
            app:layout_constraintBottom_toBottomOf="@id/btnOpenInstagram"
            app:layout_constraintEnd_toStartOf="@id/btnMoreOptions" />

        <!-- 1-Click Re-Download Button (Shown if deleted from device) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRedownload"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minHeight="0dp"
            android:text="☁  Re-download"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:backgroundTint="@color/insta_pink"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/btnOpenInstagram"
            app:layout_constraintBottom_toBottomOf="@id/btnOpenInstagram"
            app:layout_constraintEnd_toStartOf="@id/btnMoreOptions" />

        <!-- Options Button "⋮" (48dp touch target) -->
        <ImageButton
            android:id="@+id/btnMoreOptions"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/text_secondary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Options"
            app:layout_constraintTop_toTopOf="@id/btnOpenInstagram"
            app:layout_constraintBottom_toBottomOf="@id/btnOpenInstagram"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
