<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:clipToOutline="true"
    android:padding="14dp"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- Top Row: Thumbnail + Details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <!-- 72dp Thumbnail Container -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="#20202A"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/ivHistoryThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Thumbnail" />

            <!-- Type Badge Icon (Bottom-End) -->
            <ImageView
                android:id="@+id/ivHistoryTypeIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="3dp"
                android:background="#CC000000"
                android:padding="3dp"
                android:src="@drawable/ic_image"
                android:tint="@color/white"
                android:contentDescription="Type" />

            <!-- Deleted Badge Icon (Top-Start, subtle pill) -->
            <ImageView
                android:id="@+id/ivDeletedBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|start"
                android:layout_margin="3dp"
                android:background="#CC000000"
                android:padding="3dp"
                android:src="@drawable/ic_cloud_download"
                android:tint="@color/insta_coral"
                android:visibility="gone"
                android:contentDescription="Deleted from local storage" />
        </FrameLayout>

        <!-- Information Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <!-- Title: Post URL / Identifier (e.g. instagram.com/p/DfUi8HNDX94) -->
            <TextView
                android:id="@+id/tvHistoryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="instagram.com/p/DfUi8HNDX94"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="middle" />

            <!-- Subtitle: Post Type, Media Count & Size -->
            <TextView
                android:id="@+id/tvHistorySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Carousel • 12 photos • 20.1 MB"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Saved Date & Time -->
            <TextView
                android:id="@+id/tvHistoryDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Saved on Nov 04, 2026"
                android:textColor="#888899"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:maxLines="1" />

            <!-- Status Pill Badge -->
            <LinearLayout
                android:id="@+id/layoutStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="5dp"
                android:paddingStart="8dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="#1B2B20">

                <View
                    android:id="@+id/dotStatus"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@color/status_green" />

                <TextView
                    android:id="@+id/tvStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="On Device • Ready"
                    android:textColor="@color/status_green"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Real-time Download Progress Section (Visible when queued or downloading) -->
    <LinearLayout
        android:id="@+id/layoutDownloadProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvProgressMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Re-downloading..."
                android:textColor="@color/insta_pink"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvProgressPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbHistoryHorizontal"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="5dp"
            android:progressTint="@color/insta_pink"
            android:progressBackgroundTint="#33FFFFFF"
            android:max="100"
            android:progress="0" />
    </LinearLayout>

    <!-- Bottom Action Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <!-- Open in Instagram Button -->
        <Button
            android:id="@+id/btnOpenInstagram"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="View Post ↗"
            android:textSize="12sp"
            android:textColor="@color/insta_pink"
            android:background="@drawable/btn_segment_inactive"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Progress Spinner during Re-download -->
        <ProgressBar
            android:id="@+id/pbRedownload"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp"
            android:indeterminateTint="@color/insta_pink"
            android:visibility="gone" />

        <!-- View Media Button (Shown if available on device) -->
        <Button
            android:id="@+id/btnViewMedia"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="View Media"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_segment_inactive"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="visible" />

        <!-- 1-Click Re-Download Button (Shown if deleted from device) -->
        <Button
            android:id="@+id/btnRedownload"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="☁  Re-download"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/btn_rounded_accent"
            android:backgroundTint="@color/insta_pink"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
