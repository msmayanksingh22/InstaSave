<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_link"
            android:tint="@color/insta_pink"
            android:contentDescription="Link" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Download from Link"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paste Instagram Photo, Reel, or Carousel"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDismissDialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:tint="@color/text_muted"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- Input Box with Paste Shortcut -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1F2430"
        android:padding="8dp"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/etInstagramUrl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="https://www.instagram.com/p/..."
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:background="@null"
            android:padding="8dp"
            android:maxLines="2"
            android:inputType="textUri" />

        <Button
            android:id="@+id/btnPasteUrl"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Paste"
            android:textColor="@color/insta_pink"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Status / Validation message -->
    <TextView
        android:id="@+id/tvManualStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/status_amber"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/pbLoadingMedia"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <!-- Action Button -->
    <Button
        android:id="@+id/btnLoadMedia"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Load &amp; Select Media"
        android:textColor="@color/white"
        android:background="@drawable/btn_rounded_accent"
        android:textStyle="bold"
        android:textSize="14sp" />

</LinearLayout>
