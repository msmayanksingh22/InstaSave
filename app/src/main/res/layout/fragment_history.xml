<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootHistoryLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Sticky Top Header Bar -->
    <LinearLayout
        android:id="@+id/historyTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="History &amp; Archive"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/tvHistoryHeaderSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 items recorded • 0 available to re-download"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Refresh Button (48dp touch target) -->
        <ImageButton
            android:id="@+id/btnHistoryRefresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_refresh"
            app:tint="@color/text_secondary"
            android:contentDescription="Reconcile MediaStore" />
    </LinearLayout>

    <!-- Filter Chips Row -->
    <HorizontalScrollView
        android:id="@+id/scrollHistoryFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/historyTopBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipFilterAll"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:text="All (0)"
                android:textSize="12.5sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="8dp"
                app:cornerRadius="18dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                android:textColor="@color/text_secondary"
                app:backgroundTint="@color/card_bg" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipFilterOnDevice"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:text="On Device (0)"
                android:textSize="12.5sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="8dp"
                app:cornerRadius="18dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                android:textColor="@color/text_secondary"
                app:backgroundTint="@color/card_bg" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipFilterDeleted"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:text="Deleted (0)"
                android:textSize="12.5sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="18dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                android:textColor="@color/text_secondary"
                app:backgroundTint="@color/card_bg" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- History RecyclerView (16dp bottom padding) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistoryList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="100dp"
        app:layout_constraintTop_toBottomOf="@id/scrollHistoryFilters"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_history_card" />

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/pbHistoryLoading"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:indeterminateTint="@color/insta_pink"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/scrollHistoryFilters"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutEmptyHistory"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/scrollHistoryFilters"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_history"
            app:tint="@color/text_muted"
            android:contentDescription="Empty" />

        <TextView
            android:id="@+id/tvEmptyHistoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Records Found"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvEmptyHistoryDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No saved Instagram media in your history yet."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textAlignment="center"
            android:layout_marginTop="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddLink"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:layout_marginTop="20dp"
            android:text="Download Media"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="24dp"
            android:background="@drawable/btn_hero_gradient"
            app:backgroundTint="@null"
            android:textColor="@color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
