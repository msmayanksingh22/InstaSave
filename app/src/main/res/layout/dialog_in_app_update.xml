<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:backgroundTint="#161422"
    android:padding="20dp">

    <!-- Top Badge Header -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/card_background"
        android:backgroundTint="#33E1306C"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ NEW VERSION READY"
            android:textColor="@color/insta_pink"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />
    </LinearLayout>

    <!-- Header with Icon & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card_background"
                android:backgroundTint="#26E1306C" />

            <ImageView
                android:id="@+id/ivUpdateDialogIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_cloud_download"
                android:tint="@color/insta_pink"
                android:contentDescription="Update Icon" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvUpdateDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="InstaSave Update Available"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/tvUpdateDialogSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Faster downloads &amp; commercial-grade UI upgrades"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Indeterminate Loading Spinner for Initial Check -->
    <ProgressBar
        android:id="@+id/pbUpdateChecking"
        style="?android:attr/progressBarStyleHorizontal"
        android:indeterminate="true"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:indeterminateTint="@color/insta_pink"
        android:visibility="visible" />

    <!-- Feature Highlight Tags -->
    <LinearLayout
        android:id="@+id/layoutUpdateBadges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ 2x Speed"
            android:textColor="#38BDF8"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:background="@drawable/card_background"
            android:backgroundTint="#122B38"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎨 Modern UI"
            android:textColor="@color/insta_amber"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:background="@drawable/card_background"
            android:backgroundTint="#332412"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️ Free &amp; Private"
            android:textColor="@color/status_green"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:background="@drawable/card_background"
            android:backgroundTint="#162E20"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp" />
    </LinearLayout>

    <!-- Release Info & Notes Container -->
    <LinearLayout
        android:id="@+id/layoutReleaseNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:backgroundTint="#1E1C2B"
        android:padding="14dp"
        android:layout_marginBottom="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvReleaseVersion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Version 1.2.1"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="@color/insta_pink" />

            <TextView
                android:id="@+id/tvReleaseSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3.8 MB"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="@color/text_muted"
                android:background="@drawable/card_background"
                android:backgroundTint="#2A2838"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1AFFFFFF"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvReleaseNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What's new in this build..."
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>

    <!-- Download Progress Container -->
    <LinearLayout
        android:id="@+id/layoutUpdateProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:backgroundTint="#1D1A2E"
        android:padding="14dp"
        android:layout_marginBottom="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDownloadProgressStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Downloading update..."
                android:textSize="12sp"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvUpdatePercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/insta_pink" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbUpdateDownload"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/insta_pink" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btnUpdateNegative"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Later"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp"
            android:paddingHorizontal="16dp" />

        <Button
            android:id="@+id/btnUpdatePositive"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:text="Update Now ⚡"
            android:textColor="@color/white"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:background="@drawable/btn_rounded_accent"
            android:backgroundTint="@color/insta_pink"
            android:paddingHorizontal="20dp" />
    </LinearLayout>

</LinearLayout>
