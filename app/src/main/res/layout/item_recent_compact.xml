<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginEnd="10dp"
    android:gravity="center_horizontal"
    android:foreground="?android:attr/selectableItemBackground">

    <FrameLayout
        android:layout_width="160dp"
        android:layout_height="120dp"
        android:background="@drawable/card_background"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/ivRecentThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Recent Thumbnail" />

        <!-- Discreet Media Type Badge (Top-End) -->
        <FrameLayout
            android:id="@+id/layoutRecentBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="#CC000000"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/ivRecentTypeIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_video"
                android:tint="@color/white"
                android:contentDescription="Type" />

            <TextView
                android:id="@+id/tvRecentCarouselCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <TextView android:id="@+id/recentTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="15sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:textColor="@color/text_primary" />
    <TextView
        android:id="@+id/tvRecentDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Sep 05"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:gravity="start"
        android:singleLine="true"
        android:ellipsize="end" />

</LinearLayout>
