<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginEnd="12dp"
    android:gravity="center_horizontal"
    android:foreground="?android:attr/selectableItemBackground">

    <FrameLayout
        android:layout_width="160dp"
        android:layout_height="124dp"
        android:background="@drawable/card_background"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/ivRecentThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Recent Thumbnail" />

        <!-- Discreet Media Type Badge (Top-End) -->
        <LinearLayout
            android:id="@+id/layoutRecentBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="#CC090A10"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivRecentTypeIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_video"
                android:tint="@color/white"
                android:contentDescription="Type" />

            <TextView
                android:id="@+id/tvRecentCarouselCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginStart="3dp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <TextView 
        android:id="@+id/recentTitle" 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content" 
        android:layout_marginTop="8dp" 
        android:textSize="14sp" 
        android:textStyle="bold" 
        android:singleLine="true" 
        android:ellipsize="end" 
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tvRecentDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Sep 05"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:gravity="start"
        android:singleLine="true"
        android:ellipsize="end" />

</LinearLayout>
