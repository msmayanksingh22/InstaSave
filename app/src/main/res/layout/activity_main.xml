<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootMainContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Fragment Container for Home, Gallery, History, Settings -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/mainFragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Redesigned 5-Slot Obsidian Glass Navigation Dock -->
    <FrameLayout
        android:id="@+id/floatingNavContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_floating_nav_deck"
        android:elevation="16dp"
        android:clipToOutline="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp">

            <!-- 1. Home -->
            <LinearLayout
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Home">

                <FrameLayout
                    android:id="@+id/pill_nav_home"
                    android:layout_width="42dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_nav_active_pill">

                    <ImageView
                        android:id="@+id/icon_nav_home"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_home"
                        app:tint="@color/insta_pink"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:id="@+id/label_nav_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Home"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- 2. Gallery -->
            <LinearLayout
                android:id="@+id/nav_gallery"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Gallery">

                <FrameLayout
                    android:id="@+id/pill_nav_gallery"
                    android:layout_width="42dp"
                    android:layout_height="28dp">

                    <ImageView
                        android:id="@+id/icon_nav_gallery"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_gallery"
                        app:tint="@color/text_muted"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:id="@+id/label_nav_gallery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Gallery"
                    android:textSize="10.5sp"
                    android:textColor="@color/text_muted"
                    android:maxLines="1"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- 3. Center Highlighted Browse Feed Launcher -->
            <LinearLayout
                android:id="@+id/nav_feed"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Browse Instagram Feed">

                <FrameLayout
                    android:id="@+id/pill_nav_feed"
                    android:layout_width="46dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_nav_feed_launcher"
                    android:elevation="4dp">

                    <ImageView
                        android:id="@+id/icon_nav_feed"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_feed"
                        app:tint="@color/white"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:id="@+id/label_nav_feed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Feed"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- 4. History -->
            <LinearLayout
                android:id="@+id/nav_history"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="History">

                <FrameLayout
                    android:id="@+id/pill_nav_history"
                    android:layout_width="42dp"
                    android:layout_height="28dp">

                    <ImageView
                        android:id="@+id/icon_nav_history"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_history"
                        app:tint="@color/text_muted"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:id="@+id/label_nav_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="History"
                    android:textSize="10.5sp"
                    android:textColor="@color/text_muted"
                    android:maxLines="1"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- 5. Settings -->
            <LinearLayout
                android:id="@+id/nav_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Settings">

                <FrameLayout
                    android:id="@+id/pill_nav_settings"
                    android:layout_width="42dp"
                    android:layout_height="28dp">

                    <ImageView
                        android:id="@+id/icon_nav_settings"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_settings"
                        app:tint="@color/text_muted"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:id="@+id/label_nav_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Settings"
                    android:textSize="10.5sp"
                    android:textColor="@color/text_muted"
                    android:maxLines="1"
                    android:singleLine="true" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
