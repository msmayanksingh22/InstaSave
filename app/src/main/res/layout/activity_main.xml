<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/rootMainContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Brand Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_app_logo"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline"
                    android:textSize="13sp"
                    android:textColor="@color/insta_coral"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnHeaderSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_settings"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/open_settings" />
        </LinearLayout>

        <!-- Clipboard Detected Banner (Focus flow) -->
        <LinearLayout
            android:id="@+id/layoutClipboardBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_background"
            android:backgroundTint="#2D1A38"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_download_arrow"
                android:tint="@color/insta_pink"
                android:contentDescription="Link Detected" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/tvClipBannerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instagram Link Copied"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvClipBannerUrl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="instagram.com/p/..."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:singleLine="true"
                    android:ellipsize="middle" />
            </LinearLayout>

            <Button
                android:id="@+id/btnClipBannerDownload"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Review"
                android:textColor="@color/white"
                android:background="@drawable/btn_rounded_accent"
                android:textSize="12sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <ImageButton
                android:id="@+id/btnClipBannerDismiss"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:tint="@color/text_muted"
                android:contentDescription="Dismiss"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- In-App Update Available Banner -->
        <LinearLayout
            android:id="@+id/layoutUpdateAvailableBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_background"
            android:backgroundTint="#2A1428"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/card_background"
                    android:backgroundTint="#33E1306C" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_cloud_download"
                    android:tint="@color/insta_pink"
                    android:contentDescription="Update Available" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/tvUpdateBannerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎉 New Version Ready! 🚀"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/tvUpdateBannerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="InstaSave v1.2.1 is ready to install"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <Button
                android:id="@+id/btnUpdateBannerAction"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Update ⚡"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/btn_rounded_accent"
                android:backgroundTint="@color/insta_pink"
                android:textSize="12sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <ImageButton
                android:id="@+id/btnUpdateBannerDismiss"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:tint="@color/text_muted"
                android:contentDescription="Dismiss"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- 1. InstaSave Service Running State Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/dotServiceStatus"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/dot_indicator" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvServiceStatusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="InstaSave is running"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvServiceStatusSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Overlay button is active on screen"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnToggleService"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="14dp"
                android:text="Stop InstaSave"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="@color/card_bg"
                android:textColor="@color/status_red" />
        </LinearLayout>

        <!-- 2. System Prerequisites (Collapsible / Informational) -->
        <LinearLayout
            android:id="@+id/cardPrerequisites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Permissions"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <!-- Accessibility Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <View
                    android:id="@+id/dotA11yStatus"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_indicator" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/accessibility_status"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvA11ySubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Automates Instagram link copying"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnToggleA11y"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Enable"
                    android:textColor="@color/insta_pink"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Overlay Permission Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/dotOverlayStatus"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_indicator" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/overlay_status"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOverlaySubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Allows floating button over apps"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnToggleOverlay"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Grant"
                    android:textColor="@color/insta_pink"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPrereqWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/status_amber"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 3. HOME CONTROL CENTER (Primary Download Controls) -->
        <LinearLayout
            android:id="@+id/cardControlCenter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTROL CENTER"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/insta_pink"
                android:letterSpacing="0.08"
                android:layout_marginBottom="14dp" />

            <!-- Control 1: Download Mode -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Download Mode"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnModeAuto"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Automatic"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:background="@drawable/btn_segment_active"
                    android:textColor="@color/white"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnModeClipboard"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Clipboard"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:background="@drawable/btn_segment_inactive"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvModeDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Automatic: Tap the floating button in Instagram to save"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#20FFFFFF"
                android:layout_marginBottom="14dp" />

            <!-- Control 2: Carousel Behavior -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Carousel Behavior"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnCarouselEntire"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Entire"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:background="@drawable/btn_segment_active"
                    android:textColor="@color/white"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnCarouselCurrent"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Current"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:background="@drawable/btn_segment_inactive"
                    android:textColor="@color/text_secondary"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnCarouselAsk"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Ask"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:background="@drawable/btn_segment_inactive"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCarouselDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Downloads all slides in the carousel at once"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#20FFFFFF"
                android:layout_marginBottom="14dp" />

            <!-- Control 3: Save Location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_folder"
                    android:tint="@color/insta_coral"
                    android:contentDescription="Save Location" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unified Save Location"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvSaveLocationPath"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pictures/InstaSave/"
                        android:textSize="12sp"
                        android:textColor="@color/insta_pink"
                        android:layout_marginTop="1dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnChangeSaveLocation"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="Change"
                    android:textColor="@color/white"
                    android:background="@drawable/btn_segment_inactive"
                    android:textSize="12sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. Permanent Manual Download Action Card -->
        <LinearLayout
            android:id="@+id/cardPasteLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:foreground="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_link"
                android:tint="@color/insta_pink"
                android:contentDescription="Paste Link" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Paste Instagram Link"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Download any Photo, Reel, or Carousel directly"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paste"
                android:textColor="@color/insta_pink"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="4dp" />
        </LinearLayout>

        <!-- 5. Recent Downloads Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/recent_downloads_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/btnViewAllRecent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="See Gallery →"
                android:textColor="@color/insta_pink"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="4dp" />
        </LinearLayout>

        <!-- Recent Downloads Horizontal Shelf -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentDownloads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:clipToPadding="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvNoRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_recent_downloads"
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:padding="16dp"
                android:gravity="center"
                android:background="@drawable/card_background" />
        </FrameLayout>

        <!-- 6. Storage Accounting Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/storage_summary_title"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvStorageTotalSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calculating..."
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvStorageBreakdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saved in Pictures/InstaSave/"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_download_arrow"
                android:contentDescription="Storage"
                android:tint="@color/insta_coral" />
        </LinearLayout>

        <!-- 7. Quick Navigation Cards -->
        <LinearLayout
            android:id="@+id/cardNavGallery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:foreground="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_image"
                android:tint="@color/insta_pink"
                android:contentDescription="Gallery" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gallery_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_gallery_desc"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="22sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <!-- Navigation Card: Download History & Cloud Archive -->
        <LinearLayout
            android:id="@+id/cardNavHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:foreground="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_history"
                android:tint="@color/insta_coral"
                android:contentDescription="History" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="History &amp; Archive"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvNavHistorySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All saves • 1-click re-download deleted items"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="22sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardNavSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="24dp"
            android:foreground="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/insta_coral"
                android:contentDescription="Settings" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Advanced Settings"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Floating button size, opacity, docking &amp; diagnostics"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="22sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
