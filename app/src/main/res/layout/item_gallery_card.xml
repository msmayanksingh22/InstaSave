<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:layout_margin="6dp"
    android:clipToOutline="true"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- Thumbnail with Media Overlays (Strict 1:1 Aspect Ratio) -->
    <com.instadown.assist.ui.view.SquareFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_variant">

        <ImageView
            android:id="@+id/ivGalleryThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Thumbnail" />

        <!-- Media Type Badge (Top-Start) -->
        <LinearLayout
            android:id="@+id/layoutBadgeType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="#AA000000"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivGalleryTypeIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:tint="@color/white"
                android:src="@drawable/ic_image"
                android:contentDescription="Type" />

            <TextView
                android:id="@+id/tvGalleryTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="PHOTO"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Carousel Count Badge (Top-End) -->
        <TextView
            android:id="@+id/tvCarouselCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="#AA000000"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Reel Play Indicator (Center, if Reel) -->
        <ImageView
            android:id="@+id/ivPlayIndicator"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:background="#66000000"
            android:padding="6dp"
            android:src="@drawable/ic_video"
            android:tint="@color/white"
            android:visibility="gone"
            android:contentDescription="Reel" />

        <!-- Selection Tint Overlay -->
        <View
            android:id="@+id/viewSelectedOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#44E1306C"
            android:visibility="gone" />

        <!-- Selection Checkbox Badge -->
        <ImageView
            android:id="@+id/ivSelectBadge"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:src="@drawable/ic_circle_outline"
            android:visibility="gone"
            android:contentDescription="Select" />
    </com.instadown.assist.ui.view.SquareFrameLayout>

    <!-- Info Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvGalleryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Instagram Photo"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:singleLine="true"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/tvGalleryDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sep 05"
                android:textSize="10sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvGalleryStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saved"
                android:textSize="10sp"
                android:textColor="@color/status_green" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
