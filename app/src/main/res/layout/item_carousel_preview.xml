<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/card_background"
    android:padding="10dp"
    android:layout_marginBottom="8dp">

    <FrameLayout
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@color/surface_variant">

        <ImageView
            android:id="@+id/ivCarouselItemThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Item preview" />

        <ImageView
            android:id="@+id/ivCarouselItemType"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="3dp"
            android:tint="@color/white"
            android:src="@drawable/ic_image"
            android:contentDescription="Media type" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvCarouselItemTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Item 1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvCarouselItemSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.2 MB"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnViewCarouselItem"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="View"
        android:textColor="@color/insta_pink"
        android:textSize="12sp" />

</LinearLayout>
