<resources>
    <!-- Base Application Theme -->
    <style name="Theme.InstaSave" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/insta_pink</item>
        <item name="colorPrimaryDark">#101016</item>
        <item name="colorAccent">@color/insta_coral</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">#101016</item>
        <item name="android:navigationBarColor">#101016</item>
    </style>

    <!-- Official Android 12-16 Splash Screen Theme -->
    <style name="Theme.InstaSave.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0C0A12</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_app_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.InstaSave</item>
    </style>

    <!-- Backward compatibility alias -->
    <style name="Theme.InstaDown" parent="Theme.InstaSave" />
</resources>
